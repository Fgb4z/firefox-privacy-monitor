{
  "name": "firefox-privacy-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitor acadêmico de privacidade para Firefox",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "check": "npm run build && npm test && npm run lint",
    "start": "web-ext run --source-dir extension",
    "fixture": "node scripts/fixture-server.mjs",
    "package": "npm run build && web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest",
    "report": "node scripts/report.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfkit": "^0.20.2",
    "selenium-webdriver": "^4.49.0",
    "web-ext": "^10.7.0"
  }
}
